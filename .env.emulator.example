# For local development against the Emulator Suite: cp .env.emulator.example .env.local
# The "demo-" prefix tells Firebase this is an offline demo project (no real resources are touched).
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=demo-mamulaat.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-mamulaat
VITE_FIREBASE_STORAGE_BUCKET=demo-mamulaat.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000
VITE_FIREBASE_VAPID_KEY=
VITE_USE_EMULATORS=true
