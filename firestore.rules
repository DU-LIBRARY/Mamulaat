rules_version = '2';

// Mamulaat — Firestore Security Rules
//
// These rules are the ONLY access control. The UI is never trusted.
// There are no hard-coded emails or UIDs here: the admin is whoever has
// users/{uid}.role == 'admin' (with status 'active'), and that field can only
// be written by the current admin (or by the one-off bootstrap script, which
// uses the Admin SDK and therefore needs Google Cloud project access).
//
// Roles:  'student' | 'admin'   (keep the list in validRole() to add e.g. 'teacher' later)
// Status: 'pending' | 'active' | 'inactive' | 'rejected'

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn() { return request.auth != null; }
    function userPath(uid) { return /databases/$(database)/documents/users/$(uid); }
    function hasProfile() { return signedIn() && exists(userPath(request.auth.uid)); }
    function me() { return get(userPath(request.auth.uid)).data; }
    function isActive() { return hasProfile() && me().status == 'active'; }
    function isAdmin() { return isActive() && me().role == 'admin'; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function isActiveSelf(uid) { return isSelf(uid) && isActive(); }
    function isActiveOrPendingSelf(uid) { return isSelf(uid) && hasProfile() && me().status in ['active', 'pending']; }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }

    function validRole(r) { return r in ['student', 'admin']; }
    function validStatus(s) { return s in ['pending', 'active', 'inactive', 'rejected']; }
    function validTime(t) { return t == null || (t is string && t.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')); }
    function optString(v, max) { return v == null || (v is string && v.size() <= max); }

    // ---------- settings / dates ----------
    function settingsPath() { return /databases/$(database)/documents/settings/app; }
    function appSettings() {
      return exists(settingsPath()) ? get(settingsPath()).data : {};
    }
    function validDayId(day) { return day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }

    // Local midnight (in the project timezone) at the start of `day`, as a timestamp.
    // utcOffsetMinutes is written by the admin client from the IANA timezone
    // (and refreshed automatically when it changes, e.g. for DST).
    function dayStart(day, s) {
      return timestamp.date(int(day[0:4]), int(day[5:7]), int(day[8:10]))
        - duration.value(int(s.get('utcOffsetMinutes', 0)), 'm');
    }

    // A day can be written from its start until the end of day + backfillDays.
    // One hour of grace on both sides absorbs DST changes and clock skew.
    function dayEditable(day) {
      let s = appSettings();
      let start = dayStart(day, s);
      let backfill = int(s.get('backfillDays', 2));
      return request.time >= start - duration.value(1, 'h')
        && request.time < start + duration.value(backfill + 1, 'd') + duration.value(1, 'h');
    }

    // ---------- users ----------
    function validNewProfile(uid) {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'email', 'photoURL', 'role', 'status', 'classId',
                                'reminderEnabled', 'reminderTime', 'onboarded', 'createdAt',
                                'requestedClassId', 'signupComplete'])
        && d.role == 'student'
        && d.status == 'pending'
        && d.get('classId', null) == null
        && d.email == request.auth.token.email
        && optString(d.get('name', null), 200)
        && optString(d.get('photoURL', null), 2000)
        && d.get('reminderEnabled', false) == false
        && d.get('onboarded', false) == false
        && d.get('requestedClassId', null) == null
        && d.get('signupComplete', false) == false
        && d.createdAt == request.time;
    }

    // The class a new student asks to join. Only a request: the admin decides classId.
    function validRequestedClass(v) {
      return v == null
        || (v is string && v.size() > 0 && v.size() <= 100
            && exists(/databases/$(database)/documents/classes/$(v)));
    }

    // What a non-admin may change on their own profile. Never role/status/classId.
    function selfUpdateOk() {
      let d = request.resource.data;
      let basic = ['name', 'photoURL', 'lastSeenAt'];
      let pendingOnly = ['requestedClassId', 'signupComplete'];
      let activeOnly = ['reminderEnabled', 'reminderTime', 'onboarded'];
      return optString(d.get('name', null), 100)
        && (d.get('name', null) == null || d.name.trim().size() > 0)
        && validRequestedClass(d.get('requestedClassId', null))
        && d.get('signupComplete', false) is bool
        && optString(d.get('photoURL', null), 2000)
        && validTime(d.get('reminderTime', null))
        && d.get('reminderEnabled', false) is bool
        && (changed().hasOnly(basic)
            || (resource.data.status == 'pending' && changed().hasOnly(basic.concat(pendingOnly)))
            || (resource.data.status == 'active' && changed().hasOnly(basic.concat(activeOnly))));
    }

    // Admin editing someone else. Promoting someone to admin is only allowed as
    // part of a handover, i.e. the same batch must demote the current admin
    // (checked with getAfter), so there is never more than one admin.
    function adminUpdateOtherOk() {
      let d = request.resource.data;
      let promoting = d.role == 'admin' && resource.data.role != 'admin';
      return validRole(d.role) && validStatus(d.status)
        && resource.data.role != 'admin'
        // The admin may rename, change class/status and reset sign-up state, nothing else
        // (never email, createdAt, reminder settings...). `role` is only for handover.
        && changed().hasOnly(['name', 'status', 'classId', 'requestedClassId', 'signupComplete', 'role',
                              'onboarded'])
        && (!('name' in changed()) || (d.name is string && d.name.trim().size() > 0 && d.name.size() <= 100))
        && (d.get('classId', null) == null
            || (d.classId is string && exists(/databases/$(database)/documents/classes/$(d.classId))))
        && (d.get('requestedClassId', null) == null || d.requestedClassId is string)
        && (!promoting || (d.status == 'active'
                           && getAfter(userPath(request.auth.uid)).data.role != 'admin'));
    }

    // Admin editing their own profile. They can only give up the admin role by
    // handing it over: `handedOverTo` must name a user who is an active admin
    // after this batch commits.
    function adminUpdateSelfOk() {
      let d = request.resource.data;
      return validRole(d.role) && validStatus(d.status)
        && (
          (d.role == 'admin' && d.status == 'active')
          || (d.role != 'admin'
              && d.handedOverTo is string
              && d.handedOverTo != request.auth.uid
              && getAfter(userPath(d.handedOverTo)).data.role == 'admin'
              && getAfter(userPath(d.handedOverTo)).data.status == 'active')
        );
    }

    match /users/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create: if isSelf(uid) && validNewProfile(uid);
      allow update: if (isSelf(uid) && !isAdmin() && selfUpdateOk())
                    || (isAdmin() && !isSelf(uid) && adminUpdateOtherOk())
                    || (isAdmin() && isSelf(uid) && adminUpdateSelfOk());
      allow delete: if isAdmin() && !isSelf(uid);

      // ----- a student's own list of mamoolaat -----
      function validMamool(d) {
        return d.keys().hasOnly(['name', 'target', 'unit', 'active', 'order', 'createdBy', 'createdAt',
                                  'createdDate', 'removedDate', 'gaps', 'updatedBy', 'updatedAt'])
          && (d.get('gaps', []) is list && d.get('gaps', []).size() <= 50)
          && d.name is string && d.name.size() > 0 && d.name.size() <= 120
          && (d.target is int || d.target is float) && d.target > 0 && d.target <= 1000000
          && d.unit is string && d.unit.size() <= 40
          && d.active is bool
          && d.createdDate is string && validDayId(d.createdDate)
          && (d.get('removedDate', null) == null || (d.removedDate is string && validDayId(d.removedDate)))
          && d.updatedBy == request.auth.uid
          && d.updatedAt == request.time;
      }

      match /mamoolaat/{mid} {
        allow read: if isActiveSelf(uid) || isAdmin();
        allow create: if (isActiveSelf(uid) || isAdmin())
                      && validMamool(request.resource.data)
                      && request.resource.data.createdBy == request.auth.uid;
        allow update: if (isActiveSelf(uid) || isAdmin())
                      && validMamool(request.resource.data)
                      && request.resource.data.createdBy == resource.data.createdBy
                      && request.resource.data.createdDate == resource.data.createdDate;
        allow delete: if isActiveSelf(uid) || isAdmin();
      }

      // ----- daily logs, id = YYYY-MM-DD in the project timezone -----
      function validLog(d, day) {
        return d.keys().hasOnly(['date', 'entries', 'updatedAt', 'editedBy', 'editedByName'])
          && d.date == day
          && d.entries is map
          && d.entries.size() <= 100
          && d.updatedAt == request.time;
      }

      // The admin may write any day (even locked or old ones) but the log is then
      // stamped with who edited it. Students can never set or keep that stamp.
      function validAdminLog(d, day) {
        return validLog(d, day)
          && d.get('editedBy', null) == request.auth.uid
          && d.get('editedByName', '') is string
          && d.get('editedByName', '').size() <= 200;
      }
      function validStudentLog(d, day) {
        return validLog(d, day) && !('editedBy' in d) && !('editedByName' in d);
      }

      match /logs/{day} {
        allow read: if isActiveSelf(uid) || isAdmin();
        // A student writes their own logs, only inside the backfill window. The admin can write any day.
        allow create, update: if (isActiveSelf(uid) && !isAdmin() && validDayId(day) && dayEditable(day)
                                  && validStudentLog(request.resource.data, day))
                              || (isAdmin() && validDayId(day) && exists(userPath(uid))
                                  && validAdminLog(request.resource.data, day));
        allow delete: if (isActiveSelf(uid) && validDayId(day) && dayEditable(day)) || isAdmin();
      }

      // ----- comments from the admin -----
      match /comments/{cid} {
        allow read: if isActiveSelf(uid) || isAdmin();
        allow create: if isAdmin()
                      && request.resource.data.keys().hasOnly(['text', 'authorId', 'authorName', 'createdAt', 'readAt'])
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 4000
                      && request.resource.data.authorId == request.auth.uid
                      && request.resource.data.createdAt == request.time
                      && request.resource.data.get('readAt', null) == null;
        // The student can only mark a comment as read.
        allow update: if isActiveSelf(uid) && !isAdmin()
                      && changed().hasOnly(['readAt'])
                      && request.resource.data.readAt == request.time;
        allow delete: if isAdmin();
      }

      // ----- record of changes the admin made to the student's mamoolaat -----
      match /changes/{chid} {
        allow read: if isActiveSelf(uid) || isAdmin();
        allow create: if isAdmin()
                      && request.resource.data.actorId == request.auth.uid
                      && request.resource.data.createdAt == request.time
                      && request.resource.data.get('seenAt', null) == null;
        allow update: if isActiveSelf(uid) && !isAdmin()
                      && changed().hasOnly(['seenAt'])
                      && request.resource.data.seenAt == request.time;
        allow delete: if isAdmin();
      }

      // ----- FCM device tokens (doc id = token) -----
      // This device's Web Push subscription (see src/lib/messaging.ts). Read only by the
      // "Notifications" GitHub Action (Admin SDK); the admin may list them to delete a student.
      match /pushSubs/{id} {
        allow read: if isActiveOrPendingSelf(uid) || isAdmin();
        allow create, update: if isActiveOrPendingSelf(uid)
                              && request.resource.data.keys().hasOnly(['endpoint', 'p256dh', 'auth', 'createdAt', 'lastSeen', 'userAgent'])
                              && request.resource.data.endpoint is string
                              && request.resource.data.endpoint.size() <= 2000
                              && request.resource.data.endpoint.matches('^https://.*')
                              && request.resource.data.p256dh is string && request.resource.data.p256dh.size() <= 200
                              && request.resource.data.auth is string && request.resource.data.auth.size() <= 100
                              && optString(request.resource.data.get('userAgent', null), 300);
        allow delete: if isActiveOrPendingSelf(uid) || isAdmin();
      }

      // Left over from the old Firebase Cloud Messaging setup: devices delete their own on update.
      match /fcmTokens/{token} {
        // Pending sign-ups may register a device too, so they can be told when they are approved.
        // The admin may list tokens so a student's data can be deleted completely.
        allow read: if isActiveOrPendingSelf(uid) || isAdmin();
        allow create, update: if isActiveOrPendingSelf(uid)
                              && request.resource.data.keys().hasOnly(['createdAt', 'lastSeen', 'userAgent']);
        allow delete: if isActiveOrPendingSelf(uid) || isAdmin();
      }
    }

    // ---------- classes ----------
    match /classes/{classId} {
      // Class names (nothing else is stored here) are readable by any signed-in user,
      // so a new student can pick the class they belong to when signing up.
      allow read: if signedIn();
      // `template`: mamoolaat the admin adds to each student's own list (never replacing it).
      allow create, update: if isAdmin()
                            && request.resource.data.keys().hasOnly(['name', 'template'])
                            && request.resource.data.name is string
                            && request.resource.data.name.size() > 0
                            && request.resource.data.name.size() <= 100
                            && request.resource.data.get('template', []) is list
                            && request.resource.data.get('template', []).size() <= 50;
      allow delete: if isAdmin();
    }

    // ---------- nudges ("please log today" pushes sent by the admin) ----------
    // id = <uid>_<day>, so there is at most one nudge per student per day. The "Notifications"
    // GitHub Action sends the push on its next run. The student can read their own (for the in-app note).
    match /nudges/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid && isActive());
      allow create: if isAdmin()
                    && request.resource.data.keys().hasOnly(['uid', 'day', 'actorId', 'actorName', 'createdAt'])
                    && request.resource.data.uid is string
                    && request.resource.data.day is string
                    && validDayId(request.resource.data.day)
                    && id == request.resource.data.uid + '_' + request.resource.data.day
                    && exists(userPath(request.resource.data.uid))
                    && request.resource.data.actorId == request.auth.uid
                    && request.resource.data.actorName is string
                    && request.resource.data.actorName.size() <= 200
                    && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ---------- pushMessages (a note from the admin, also sent to the student's phone) ----------
    // The "Notifications" GitHub Action sends each one and then deletes it. Nobody reads them in the app.
    match /pushMessages/{id} {
      allow create: if isAdmin()
                    && request.resource.data.keys().hasOnly(['uid', 'text', 'actorId', 'actorName', 'createdAt'])
                    && request.resource.data.uid is string
                    && exists(userPath(request.resource.data.uid))
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 300
                    && request.resource.data.actorId == request.auth.uid
                    && request.resource.data.actorName is string
                    && request.resource.data.actorName.size() <= 200
                    && request.resource.data.createdAt == request.time;
      allow read, update: if false;
      allow delete: if isAdmin();
    }

    // ---------- settings ----------
    match /settings/{docId} {
      allow read: if isActive();
      allow write: if isAdmin() && docId == 'app'
                   && request.resource.data.backfillDays is int
                   && request.resource.data.backfillDays >= 0
                   && request.resource.data.backfillDays <= 30
                   && request.resource.data.weekStart is int
                   && request.resource.data.weekStart >= 0
                   && request.resource.data.weekStart <= 6
                   && request.resource.data.timezone is string
                   && request.resource.data.utcOffsetMinutes is int
                   && request.resource.data.attentionThreshold is number
                   && request.resource.data.attentionThreshold >= 0
                   && request.resource.data.attentionThreshold <= 100
                   && request.resource.data.attentionNoLogDays is int
                   && request.resource.data.attentionNoLogDays >= 1
                   && request.resource.data.attentionNoLogDays <= 60
                   && validTime(request.resource.data.defaultReminderTime);
    }

    // ---------- audit log (append-only) ----------
    match /auditLog/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin()
                    && request.resource.data.actorId == request.auth.uid
                    && request.resource.data.action is string
                    && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
  }
}
